      <img src="https://via.placeholder.com/300x400" alt="Mujer feliz con celular">
    </div>
  </header>

  <section class="services">
    <h2>Servicios</h2>
    <div class="service-items">
      <div class="service">
        <img src="https://img.icons8.com/ios-filled/50/000000/edit--v1.png" alt="">
        <h3>Diseño de Logos</h3>
        <p>Lorem ipsum dolor sit amet.</p>
      </div>
      <div class="service">
        <img src="https://img.icons8.com/ios-filled/50/000000/play-button-circled--v1.png" alt="">
        <h3>Videos Promocionales</h3>
        <p>Lorem ipsum dolor sit amet.</p>
      </div>
      <div class="service">
        <img src="https://img.icons8.com/ios-filled/50/000000/megaphone.png" alt="">
        <h3>Campañas en Redes Sociales</h3>
        <p>Lorem ipsum dolor sit amet.</p>
      </div>
      <div class="service">
        <img src="https://img.icons8.com/ios-filled/50/000000/musical-notes.png" alt="">
        <h3>Canciones Personalizadas</h3>
        <p>Lorem ipsum dolor sit amet.</p>
      </div>
    </div>
  </section>

  <footer>
    <div class="socials">
      <a href="#"><img src="https://img.icons8.com/ios-filled/30/000000/facebook-new.png"/></a>
      <a href="#"><img src="https://img.icons8.com/ios-filled/30/000000/instagram-new.png"/></a>
      <a href="#"><img src="https://img.icons8.com/ios-filled/30/000000/youtube-play.png"/></a>
    </div>
    <p>&copy; 2024 VisualMusic</p>
  </footer>
